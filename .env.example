# Copy this file to .env and fill in the blanks.
#   Copy-Item .env.example .env
# Then check everything with:  python -m voice_os doctor

# ---------------------------------------------------------------------------
# LiveKit -- required. Free tier at https://cloud.livekit.io
# Project settings -> API Keys. These carry the realtime audio, so there is no
# way around them.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livelab.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# LLM -- pointed at 9Router by default.
# 9Router is an OpenAI-compatible gateway on your own machine that fronts 60+
# providers, so the model below is whatever it is routing to. Start it with:
#   npx 9router
# List what it offers:
#   curl http://localhost:20128/v1/models -H "Authorization: Bearer 9router"
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:20128/v1
# 9Router issues its own key from Dashboard -> API Keys. It is NOT the literal
# string "9router", even though /v1/models will happily accept anything.
LLM_API_KEY=
# Pick an id from the list above (curl http://localhost:20128/v1/models -H "Authorization: Bearer $LLM_API_KEY").
#
# Tool calling matters more than raw quality here: the agent is useless if the
# model answers about clicking instead of calling the tool. Verified working
# with tool calls on 9Router:
#   ag/claude-sonnet-4-6     <- good default
#   ag/gemini-3.8-flash      <- responds, but skipped the tool call entirely
LLM_MODEL=ag/claude-sonnet-4-6
LLM_TEMPERATURE_X100=60
LLM_MAX_TOKENS=1200

# To use a hosted provider directly instead of 9Router, set:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Speech to text -- required. Deepgram has the best realtime latency and a free
# tier. Alternatives: openai (uses OPENAI_API_KEY).
# ---------------------------------------------------------------------------
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=en-US
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Text to speech -- required. Cartesia is the lowest-latency option.
# Alternative: openai (uses OPENAI_API_KEY, model gpt-4o-mini-tts).
# ---------------------------------------------------------------------------
TTS_PROVIDER=cartesia
TTS_MODEL=sonic-3
CARTESIA_API_KEY=
# Leave blank for Cartesia's default voice. Find others at https://cartesia.ai/voices
TTS_VOICE=

# ---------------------------------------------------------------------------
# Turn taking
#   hosted = LiveKit's end-of-turn model, fastest and understands "mm-hm"
#   local  = multilingual model in-process, no extra hop
#   vad    = plain silence timing
#   off    = never auto-detects end of turn
# ---------------------------------------------------------------------------
TURN_DETECTION=hosted
TURN_MIN_DELAY_X100=40
TURN_MAX_DELAY_X100=200
ALLOW_INTERRUPTIONS=true
# Raise this if the agent talks over you. 1 means a single word can interrupt.
MIN_INTERRUPTION_WORDS=1
MIN_INTERRUPTION_MS=500
PREEMPTIVE_GENERATION=false

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# The agent can never change anything until it is armed, and high-risk actions
# (clicks, keys, drags, closing windows, shell) need spoken confirmation each
# time regardless of arm state.
#
# Automatically disarm after this many idle minutes. Set 0 to never auto-disarm.
AUTO_DISARM_MINUTES=15
# How long a spoken "yes" stays valid for the action it confirmed.
CONFIRMATION_TTL=90

# Shell execution is OFF by default. Even once enabled, a denylist still blocks
# destructive commands. Turn this on only if you actually need it.
ALLOW_SHELL=false
# Comma-separated additions to the built-in denylist:
# SHELL_DENYLIST=rd /s /q,del /f /s /q

# ---------------------------------------------------------------------------
# Local control server (serves the web UI and mints LiveKit tokens)
# Loopback only. Do not change this without adding authentication.
# ---------------------------------------------------------------------------
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787

# ---------------------------------------------------------------------------
# Desktop overlay
# The always-on-top corner orb plus live subtitles. Start it with:
#   .\run.ps1 -Overlay
# or on its own (the agent must already be running):
#   python -m voice_os overlay
# ---------------------------------------------------------------------------
# Which screen corner to sit in: bottom-right, bottom-left, top-right, top-left
# bottom-right keeps it clear of the taskbar and window buttons.
OVERLAY_CORNER=bottom-right

# Anything here is appended to the agent's instructions. Useful for pinning
# down house conventions, e.g. "We call the notes app Obsidian."
# AGENT_EXTRA_INSTRUCTIONS=

# ---------------------------------------------------------------------------
# Brain - memory, skills, and (optionally) a document store
#
# The brain is what the agent knows rather than what it can do. It runs inside
# the voice worker, has no separate login, and every one of its capabilities
# passes through the same arm/confirmation gate as the desktop tools. Read-only
# brain tools (recall_memory, find_skills, read_skill) work while disarmed;
# writing a memory needs arm plus a spoken yes, every time.
# ---------------------------------------------------------------------------
BRAIN_ENABLED=true

# Where the skill packs live. Each subdirectory holds a SKILL.md. The repo
# ships 32. Point this elsewhere to add your own.
BRAIN_SKILLS_DIR=skills

# SQLite file for memories, preferences, conversations and artifacts.
# Holds everything the agent has been told, so back it up if that matters.
BRAIN_DB=.data/brain.db

# Cap on how much of one skill pack goes into a single prompt. Packs run from
# 800 bytes to 88 KB, and a spoken turn has a small budget. Lower it if the
# agent starts losing the thread; raise it only for very short packs.
BRAIN_SKILL_BRIEF_CHARS=6000

# How many packs a skill search returns, and how many stored notes one recall
# can bring back.
BRAIN_SKILL_SEARCH_LIMIT=5
BRAIN_RECALL_LIMIT=8

# Set to false to make the agent amnesiac. Reads keep working; nothing new is
# stored. Useful if you want to try the agent without it accumulating anything.
BRAIN_REMEMBER=true

# ---------------------------------------------------------------------------
# Document knowledge store (the data kernel) - OFF by default
#
# Lets the agent search and reason over documents you have loaded, with
# provenance on every result. It imports pandas and numpy, which is a real cost
# at voice-session startup, so it stays off until you want it.
#
# To turn it on:
#   1. pip install -e ".[kernel]"
#   2. set BRAIN_DATA_KERNEL=true below
#
# Note its compute sandbox is an AST filter, not a true isolation boundary, so
# asking it a question is a high-risk action that needs confirmation, same as
# running a shell command.
# ---------------------------------------------------------------------------
BRAIN_DATA_KERNEL=false
BRAIN_BLOB_DIR=.data/blobs
